rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Cualquier usuario autenticado (anon) puede leer la sala
      allow read: if request.auth != null;

      // Solo se puede crear si el createdBy coincide con el caller
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy is string;

      // Solo el admin (creador) puede modificar la sala (columnas, timer, revealed)
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;

      // No se borran salas (futuro: TTL via Cloud Function)
      allow delete: if false;

      // CARDS
      match /cards/{cardId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;

        // El autor o el admin de la sala pueden modificar/borrar
        allow update, delete: if request.auth != null
                              && (resource.data.authorUid == request.auth.uid
                                  || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }

      // USERS (presencia y display name)
      match /users/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // FEEDBACK global (write-only desde la app, lectura solo via consola)
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
