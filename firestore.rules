rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reacciones del formato viejo (set fijo, { like: [uid] }): mantener en
    // sync con LEGACY_REACTIONS en src/lib/reactions.ts. La app ya solo saca
    // uids de acá; agregar queda permitido para pestañas con la versión vieja.
    function onlyOwnUidChanged(before, after, k) {
      let b = before.get(k, []).toSet();
      let a = after.get(k, []).toSet();
      return a.difference(b).hasOnly([request.auth.uid])
          && b.difference(a).hasOnly([request.auth.uid]);
    }

    function validReactions(before, after) {
      return after is map
          && after.keys().hasOnly(['like', 'love', 'laugh', 'party', 'think', 'rocket'])
          && onlyOwnUidChanged(before, after, 'like')
          && onlyOwnUidChanged(before, after, 'love')
          && onlyOwnUidChanged(before, after, 'laugh')
          && onlyOwnUidChanged(before, after, 'party')
          && onlyOwnUidChanged(before, after, 'think')
          && onlyOwnUidChanged(before, after, 'rocket');
    }

    // Reacciones estilo Slack: reactionsBy: { [uid]: { [emoji]: millis } }.
    // Cada uno toca solo su propio mapa, con un tope de emojis por tarjeta.
    function validReactionsBy(before, after) {
      return after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after.get(request.auth.uid, {}) is map
          && after.get(request.auth.uid, {}).size() <= 50;
    }

    match /rooms/{roomId} {
      // Cualquier usuario autenticado (anon) puede leer la sala
      allow read: if request.auth != null;

      // Solo se puede crear si el createdBy coincide con el caller
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy is string;

      // Solo el admin (creador) puede modificar la sala (columnas, timer, revealed)
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;

      // No se borran salas (futuro: TTL via Cloud Function)
      allow delete: if false;

      // CARDS
      match /cards/{cardId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;

        // El autor o el admin de la sala pueden modificar/borrar
        allow update, delete: if request.auth != null
                              && (resource.data.authorUid == request.auth.uid
                                  || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);

        // Reacciones: cualquiera puede tocar SOLO los campos de reacciones, y
        // dentro de ellos solo lo suyo.
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionsBy'])
                      && validReactions(resource.data.get('reactions', {}),
                                        request.resource.data.get('reactions', {}))
                      && validReactionsBy(resource.data.get('reactionsBy', {}),
                                          request.resource.data.get('reactionsBy', {}));
      }

      // USERS (presencia y display name)
      match /users/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // FEEDBACK global (write-only desde la app, lectura solo via consola)
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
