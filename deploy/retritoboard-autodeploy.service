# Canónico: dazxon/retritoboard deploy/. Instalar: deploy/README.md.
[Unit]
Description=retritoboard auto-deploy a GitHub Pages (gh-pages) cuando origin/main cambia
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agustin
Group=agustin
WorkingDirectory=/home/agustin/apps/retritoboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/agustin/apps/retritoboard/deploy/autodeploy.sh
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
